<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>12</LangVersion>
        <Nullable>enable</Nullable>
        <RootNamespace>CrossQuest</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
      <PackageReference Include="Mono.Cecil" Version="0.11.6" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    </ItemGroup>

    <ItemGroup>
      <Reference Include="IPA.BuildProcess">
        <HintPath>..\Dependencies\IPA.BuildProcess.dll</HintPath>
      </Reference>
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Resources\AndroidManifest.xml" />
      <EmbeddedResource Include="Resources\boot.config" />
      <EmbeddedResource Include="Resources\debug_cert.crt" />
      <EmbeddedResource Include="Resources\debug_key.pk8" />
      <EmbeddedResource Include="Resources\link.xml" />
    </ItemGroup>

</Project>
